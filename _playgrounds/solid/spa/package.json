{
	"name": "@lanka-playgrounds/solid-spa",
	"private": true,
	"type": "module",
	"description": "Atlas in Solid: a Vite single-page application, with compiled JSX and the same ViewModels every other host reads.",
	"scripts": {
		"//dev": "The application, against the API on port 4380. Start the server first.",
		"dev": "vite",
		"//build:app": "NOT `build`. `pnpm verify:build` is `pnpm -r run build` and it exists to check what is PUBLISHED.",
		"build:app": "vite build",
		"preview": "vite preview",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@lanka-playgrounds/_shared": "workspace:^",
		"@lanka-playgrounds/solid-shared": "workspace:^",
		"@lankajs/blob-cache": "workspace:^",
		"@lankajs/plugin-devtools": "workspace:^",
		"@lankajs/plugin-prefetch": "workspace:^",
		"@lankajs/plugin-sse": "workspace:^",
		"@lankajs/plugin-websocket": "workspace:^",
		"@lankajs/solid": "workspace:^",
		"@lankajs/storage": "workspace:^",
		"@lankajs/tanstack-query": "workspace:^",
		"@tanstack/query-core": "^5.102.8",
		"lanka": "workspace:^",
		"solid-js": "^1.9.15",
		"zustand": "^5.0.10"
	},
	"devDependencies": {
		"@lanka-playgrounds/_server": "workspace:^",
		"@lankajs/tool-di": "workspace:^",
		"@lankajs/tool-eslint": "workspace:^",
		"@lankajs/tool-testing": "workspace:^",
		"@solidjs/testing-library": "^0.8.10",
		"@testing-library/dom": "^10.4.1",
		"jsdom": "^27.4.0",
		"vite": "^7.3.1",
		"vite-plugin-solid": "^2.11.10"
	}
}
