{
	"name": "@lanka-playgrounds/solid-shared",
	"private": true,
	"type": "module",
	"description": "Atlas for Solid: the VIEW layer every Solid host shares — accessors over the shared ViewModels, and the text rule its screens agree on.",
	"exports": {
		".": "./src/index.ts"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"lint": "eslint src --max-warnings=0",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@lanka-playgrounds/_shared": "workspace:^",
		"@lankajs/host": "workspace:^",
		"@lankajs/solid": "workspace:^",
		"lanka": "workspace:^",
		"solid-js": "^1.9.15"
	},
	"devDependencies": {
		"@lankajs/tool-testing": "workspace:^",
		"@solidjs/testing-library": "^0.8.10",
		"@testing-library/dom": "^10.4.1",
		"jsdom": "^27.4.0",
		"vite-plugin-solid": "^2.11.10"
	},
	"peerDependencies": {
		"zustand": "^5.0.10"
	}
}
