{
	"name": "@lanka-playgrounds/node",
	"private": true,
	"type": "module",
	"description": "Atlas with no screen at all: a node service that starts the framework, watches a ViewModel through subscribe, and gives every request its own instance.",
	"scripts": {
		"//start": "The service, against the API on port 4380. Start the server first.",
		"start": "tsx src/main.ts",
		"lint": "eslint src --max-warnings=0",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@lanka-playgrounds/_shared": "workspace:^",
		"@lankajs/host": "workspace:^",
		"@lankajs/plugin-sse": "workspace:^",
		"@lankajs/plugin-websocket": "workspace:^",
		"lanka": "workspace:^",
		"zustand": "^5.0.10"
	},
	"devDependencies": {
		"@lanka-playgrounds/_server": "workspace:^",
		"@lankajs/tool-di": "workspace:^",
		"@lankajs/tool-eslint": "workspace:^",
		"@lankajs/tool-testing": "workspace:^",
		"tsx": "^4.20.3"
	}
}
