{
	"name": "@lanka-playgrounds/angular-shared",
	"private": true,
	"type": "module",
	"description": "Atlas for Angular: the VIEW layer every Angular host shares — signals over the shared ViewModels, and the text rule its screens agree on.",
	"exports": {
		".": "./src/index.ts"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"lint": "eslint src --max-warnings=0",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@angular/common": "^20.3.31",
		"@angular/core": "^20.3.31",
		"@lanka-playgrounds/_shared": "workspace:^",
		"@lankajs/angular": "workspace:^",
		"@lankajs/host": "workspace:^",
		"lanka": "workspace:^"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "^2.7.2",
		"@angular/compiler": "^20.3.31",
		"@angular/platform-browser": "^20.3.31",
		"@lankajs/tool-testing": "workspace:^",
		"@testing-library/angular": "^17.4.0",
		"@testing-library/dom": "^10.4.1",
		"jsdom": "^27.4.0",
		"vite": "^7.3.1"
	},
	"peerDependencies": {
		"zustand": "^5.0.10"
	}
}
