---
import { AtlasBoardIsland } from "../Modules/AtlasBoardModule/AtlasBoardIsland";
import AtlasBoardIslandSvelte from "../Modules/AtlasBoardModule/AtlasBoardIslandSvelte.svelte";
import AtlasBoardIslandVue from "../Modules/AtlasBoardModule/AtlasBoardIslandVue.vue";
import { AtlasBoardIslandSolid } from "../Modules/AtlasBoardModule/AtlasBoardIslandSolid";
import { readAtlasBoard } from "../Core/Server/readAtlasBoard";

/*
 * The one place an Astro application needs `@lankajs/host`.
 *
 * This runs on the server, per request, and every decision it makes lives under
 * `src/` where a test can import it without a renderer. What is left here is the
 * shape Astro chose: frontmatter, then markup.
 */
const missions = await readAtlasBoard(Astro.request.headers);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Atlas — Astro</title>
	</head>
	<body>
		<main>
			<h1>The board</h1>
			<p data-testid="server-count">{missions.length} missions, rendered on the server</p>

			<!--
				FOUR islands, one page, one set of rows.

				`client:load` is what makes each of these an island: the markup above is
				HTML the server wrote, and these components are the parts that become
				interactive. They receive the SAME prop, call the SAME hydration, and read
				the SAME ViewModel out of `@lanka-playgrounds/_shared` — what differs
				between them is each framework's own syntax.

				This page is the strongest form of the claim `_plans/14` was written to
				make. If lanka knew which renderer it was under, four of them side by side
				on one page is where it could not hide.
			-->
			<AtlasBoardIsland missions={missions} client:load />
			<AtlasBoardIslandVue missions={missions} client:load />
			<AtlasBoardIslandSvelte missions={missions} client:load />
			<AtlasBoardIslandSolid missions={missions} client:load />
		</main>
	</body>
</html>
