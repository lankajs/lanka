{
	"name": "@lanka-playgrounds/astro",
	"private": true,
	"type": "module",
	"description": "Atlas inside Astro: a server-rendered page, a client island, and the same two host calls under a different bundler.",
	"scripts": {
		"dev": "astro dev --port 4393",
		"//build:app": "NOT `build`. `pnpm verify:build` is `pnpm -r run build` and it exists to check what is PUBLISHED.",
		"build:app": "astro build",
		"preview": "astro preview --port 4393",
		"lint": "eslint src --max-warnings=0",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.5",
		"@astrojs/react": "^6.0.5",
		"@astrojs/solid-js": "^5.1.1",
		"@astrojs/svelte": "^7.2.1",
		"@astrojs/vue": "^7.0.3",
		"@lanka-playgrounds/_shared": "workspace:^",
		"@lanka-playgrounds/react-shared": "workspace:^",
		"@lanka-playgrounds/solid-shared": "workspace:^",
		"@lanka-playgrounds/svelte-shared": "workspace:^",
		"@lanka-playgrounds/vue-shared": "workspace:^",
		"@lankajs/host": "workspace:^",
		"@lankajs/react": "workspace:^",
		"@lankajs/solid": "workspace:^",
		"@lankajs/storage": "workspace:^",
		"@lankajs/svelte": "workspace:^",
		"@lankajs/vue": "workspace:^",
		"astro": "^7.3.2",
		"lanka": "workspace:^",
		"react": "^19.2.0",
		"react-dom": "^19.2.8",
		"solid-js": "^1.9.15",
		"svelte": "^5.57.0",
		"vue": "^3.5.42",
		"zustand": "^5.0.10"
	},
	"devDependencies": {
		"@lanka-playgrounds/_server": "workspace:^",
		"@lankajs/tool-di": "workspace:^",
		"@lankajs/tool-testing": "workspace:^",
		"@solidjs/testing-library": "^0.8.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/vue": "^8.1.0",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^5.1.2",
		"@vitejs/plugin-vue": "^6.0.9",
		"jsdom": "^27.4.0",
		"vite-plugin-solid": "^2.11.10"
	}
}
