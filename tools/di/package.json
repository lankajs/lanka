{
	"name": "@lankajs/tool-di",
	"version": "1.0.1",
	"type": "module",
	"description": "tool: The `@lanka_di` alias, scaffolding for six barrels, and a contract check before the build starts — for six bundlers, or for one with no adapter at all.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lankajs/lanka.git",
		"directory": "tools/di"
	},
	"homepage": "https://github.com/lankajs/lanka/tree/main/tools/di#readme",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./vite": "./src/vite.ts",
		"./webpack": "./src/webpack.ts",
		"./turbopack": "./src/turbopack.ts",
		"./rollup": "./src/rollup.ts",
		"./esbuild": "./src/esbuild.ts",
		"./metro": "./src/metro.ts"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"skills"
	],
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./webpack": {
				"types": "./dist/webpack.d.ts",
				"default": "./dist/webpack.js"
			},
			"./turbopack": {
				"types": "./dist/turbopack.d.ts",
				"default": "./dist/turbopack.js"
			},
			"./rollup": {
				"types": "./dist/rollup.d.ts",
				"default": "./dist/rollup.js"
			},
			"./esbuild": {
				"types": "./dist/esbuild.d.ts",
				"default": "./dist/esbuild.js"
			},
			"./metro": {
				"types": "./dist/metro.d.ts",
				"default": "./dist/metro.js"
			}
		}
	},
	"scripts": {
		"build": "tsup",
		"lint": "eslint src _playground --max-warnings=0",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"bench": "vitest bench --run",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"vite": "^7.3.1"
	},
	"peerDependencies": {
		"vite": "^7.3.1"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
