{
	"name": "@lankajs/tool-eslint",
	"version": "1.0.1",
	"type": "module",
	"description": "tool: The framework's main promise — imports go one way — is checked by the framework, not by its consumers.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lankajs/lanka.git",
		"directory": "tools/eslint"
	},
	"homepage": "https://github.com/lankajs/lanka/tree/main/tools/eslint#readme",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"skills"
	],
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsup",
		"lint": "eslint src _playground --max-warnings=0",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"bench": "vitest bench --run",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"eslint": "^9.39.2"
	},
	"peerDependencies": {
		"eslint": ">=9"
	}
}
